{
  "name": "@attestprotocol/horizon",
  "version": "1.7.0",
  "description": "Stellar Horizon Indexer for monitoring and processing blockchain events",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:nodemon": "nodemon src/index.ts",
    "start": "node dist/index.js",
    "start:ts": "ts-node src/index.ts",
    "lint": "eslint --fix src __tests__",
    "lint:ts": "tsc --noEmit",
    "test": "pnpm test:integration && pnpm test:unit",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "test:unit": "vitest run __tests__/*.unit.test.ts",
    "test:integration": "VITEST_MODE=integration vitest run __tests__/*.integration.test.ts",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "stellar",
    "horizon",
    "indexer",
    "blockchain",
    "soroban"
  ],
  "author": "Andrew Miracle <andrew@daccred.co>",
  "repository": {
    "type": "git",
    "url": "https://github.com/daccred/attest.so.git"
  },
  "dependencies": {
    "@attestprotocol/stellar-contracts": "workspace:*",
    "@attestprotocol/stellar-sdk": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@stellar/stellar-sdk": "^16.3.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "lodash": "^4.18.1",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@noble/hashes": "^2.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.17",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.8"
  }
}
