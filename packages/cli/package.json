{
  "name": "@attestprotocol/cli",
  "description": "Unified CLI for Attest Protocol across all supported blockchains",
  "version": "2.0.2",
  "author": "Andrew Miracle <andrew@daccred.co>",
  "bin": {
    "attest-protocol": "./dist/bin/run.js"
  },
  "bugs": "https://github.com/daccred/attest.so/issues",
  "dependencies": {
    "@attestprotocol/sdk": "workspace:*",
    "consola": "^3.4.2",
    "dotenv": "^16.6.1",
    "picocolors": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.2",
    "@types/prompts": "^2.4.9",
    "@types/signale": "^1.4.7",
    "@types/yargs": "^17.0.35",
    "jest": "^29.7.0",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "directories": {
    "bin": "bin",
    "lib": "src"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/daccred/attest.so#readme",
  "keywords": [
    "attestation",
    "blockchain",
    "cli",
    "stellar"
  ],
  "license": "MIT",
  "main": "./dist/bin/run.js",
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=16.0.0 <17"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "daccred/attest.so.git",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rimraf dist",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "compile": "tsc",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "release": "semantic-release",
    "start": "ts-node ./bin/run.ts",
    "start:node": "node ./bin/run",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "type": "commonjs"
}
