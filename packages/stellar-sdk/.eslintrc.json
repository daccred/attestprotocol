{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": ["dist/", "node_modules/", "__tests__/", "examples/"],
  "rules": {
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["src/utils/debug.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
